# OpenAI / LLM API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# LangSmith Tracing & Observability (Optional)
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=email-assistant

# Server Configuration
HOST=0.0.0.0
PORT=8000

# MongoDB Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster0.wczoetv.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
DATABASE_NAME=ai_email_assistant

# JWT Authentication
JWT_SECRET=supersecret-jwt-token-key-change-in-production-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth 2.0 Credentials (Gmail & Google Calendar)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Google Cloud Pub/Sub Webhooks (Optional for push notifications)
GOOGLE_PUBSUB_TOPIC=projects/your-project-id/topics/your-topic-name
GOOGLE_PUBSUB_VERIFICATION_TOKEN=your-random-verification-token
